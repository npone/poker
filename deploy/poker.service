[Unit]
Description=poker: Hold'em web game + /api/v1 (localhost only; reached through the Cloudflare tunnel)
After=network-online.target
Wants=network-online.target

[Service]
User=nliu
WorkingDirectory=/home/nliu/dev/poker/src
# data root, outside the checkout (npone-site/PORTABILITY.md)
Environment=POKER_DB=/srv/npone/poker/poker.db
ExecStart=/home/nliu/miniconda3/bin/python -m uvicorn server:app --host 127.0.0.1 --port 8094 --no-access-log
Restart=always
RestartSec=5
# dev176 also runs live trading: this service must never starve it.
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryLimit=512M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/npone/poker
PrivateTmp=true

[Install]
WantedBy=multi-user.target
